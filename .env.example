# Copie para .env e ajuste.

# Banco de dados (MySQL / MariaDB).
DB_HOST=localhost
DB_PORT=3306
DB_USER=inventario
DB_PASSWORD=troque-esta-senha
DB_NAME=inventario

# Banco usado pelos testes automatizados (tests/), separado do banco de uso normal.
DB_NAME_TEST=inventario_test

# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=chave-de-teste-para-dev

# Gestor criado na primeira subida, se ainda não existir nenhum no banco.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha-de-teste-123

# Modelo de IA treinado, usado nas verificações.
MODEL_PATH=neural/producao.pt

# Servidor da API.
HOST=0.0.0.0
PORT=8000

# Endereço do front-end, liberado no CORS.
FRONTEND_ORIGIN=http://localhost:5173
