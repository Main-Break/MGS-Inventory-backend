# Configurações do projeto. Copie para .env e ajuste.

# Banco de dados: SQLITE, MYSQL ou MARIADB
DB_TYPE=SQLITE

# SQLite (desenvolvimento)
SQLITE_FILE=./inventario.db

# MySQL / MariaDB (usados quando DB_TYPE não for SQLITE)
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASS=

# Autenticação. Em produção (DEBUG=false) o JWT_SECRET é obrigatório.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Gestor criado na primeira subida, se ainda não existir nenhum no banco.
# Troque a senha em PATCH /users/me depois do primeiro login.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=

# Fotos enviadas e modelo treinado (.pt do YOLO)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
MODEL_PATH=./modelos/producao.pt

# Servidor
HOST=0.0.0.0
PORT=8000
RELOAD=true
DEBUG=true
